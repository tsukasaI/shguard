(* #"src/decision.rs" 72 0 72 46 *)

let%span sord = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sdecision = "src/decision.rs" 71 10 71 29
let%span sdecision'0 = "src/decision.rs" 25 4 25 22
let%span sdecision'1 = "src/decision.rs" 31 4 31 42
let%span sdecision'2 = "src/decision.rs" 15 4 19 5

use int.Int

type t_Decision = Allow | Ask | Block

function rank [#"src/decision.rs" 14 0 14 31] (d: t_Decision) : int = [%#sdecision'2] match d with
    | Allow -> 0
    | Ask -> 1
    | Block -> 2
    end

predicate le [#"src/decision.rs" 24 0 24 43] (a: t_Decision) (b: t_Decision) = [%#sdecision'0] rank a <= rank b

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function join_l [#"src/decision.rs" 30 0 30 51] (a: t_Decision) (b: t_Decision) : t_Decision =
  [%#sdecision'1] if ge_log_Int (rank a) (rank b) then a else b

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_Decision

constant b : t_Decision

function lemma_le_join [#"src/decision.rs" 72 0 72 46] (a: t_Decision) (b: t_Decision) : ()

goal vc_lemma_le_join: [@stop_split] [@expl:lemma_le_join ensures] [%#sdecision] le a (join_l a b)
