let%span sord = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sdecision = "src/decision.rs" 38 10 38 16
let%span sdecision'0 = "src/decision.rs" 35 10 35 46
let%span sdecision'1 = "src/decision.rs" 36 10 36 32
let%span sdecision'2 = "src/decision.rs" 15 4 19 5
let%span sdecision'3 = "src/decision.rs" 31 4 31 42

use creusot.prelude.Any
use int.MinMax
use int.Int

type t_Decision = Allow | Ask | Block

type tup2_Decision_Decision = { f0: t_Decision; f1: t_Decision }

function rank [#"src/decision.rs" 14 0 14 31] (d: t_Decision) : int = [%#sdecision'2] match d with
    | Allow -> 0
    | Ask -> 1
    | Block -> 2
    end

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function join_l [#"src/decision.rs" 30 0 30 51] (a: t_Decision) (b: t_Decision) : t_Decision =
  [%#sdecision'3] if ge_log_Int (rank a) (rank b) then a else b

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let join [#"src/decision.rs" 37 0 37 49] (a: t_Decision) (b: t_Decision) (return (x: t_Decision)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_9 <- { f0 = a; f1 = b } ] s1
    | s1 = any [ br0 -> {_9.f0 = Allow} (! bb1) | br1 -> {_9.f0 = Ask} (! bb1) | br2 -> {_9.f0 = Block} (! bb10) ] ]
  | bb1 = any [ br0 -> {_9.f1 = Allow} (! bb2) | br1 -> {_9.f1 = Ask} (! bb2) | br2 -> {_9.f1 = Block} (! bb10) ]
  | bb2 = any [ br0 -> {_9.f0 = Allow} (! bb3) | br1 -> {_9.f0 = Ask} (! bb9) | br2 -> {_9.f0 = Block} (! bb3) ]
  | bb3 = any [ br0 -> {_9.f1 = Allow} (! bb5) | br1 -> {_9.f1 = Ask} (! bb9) | br2 -> {_9.f1 = Block} (! bb4) ]
  | bb5 = any [ br0 -> {_9.f0 = Allow} (! bb6) | br1 -> {_9.f0 = Ask} (! bb4) | br2 -> {_9.f0 = Block} (! bb4) ]
  | bb4 = {[%#sdecision] false} any
  | bb6 = s0 [ s0 = [ &_ret <- Allow ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- Ask ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- Block ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Decision = Any.any_l ()
  | & a: t_Decision = a
  | & b: t_Decision = b
  | & _9: tup2_Decision_Decision = Any.any_l () ])
  [ return (result: t_Decision) ->
  {[@stop_split] [@expl:join ensures] ([@stop_split] [@expl:join ensures #0] [%#sdecision'0] rank result
      = MinMax.max (rank a) (rank b))
    /\ ([@stop_split] [@expl:join ensures #1] [%#sdecision'1] result = join_l a b)}
    (! return {result}) ]
