(* #"src/decision.rs" 52 0 52 48 *)

let%span sord = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sdecision = "src/decision.rs" 51 10 51 38
let%span sdecision'0 = "src/decision.rs" 31 4 31 42
let%span sdecision'1 = "src/decision.rs" 15 4 19 5

use int.Int

type t_Decision = Allow | Ask | Block

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function rank [#"src/decision.rs" 14 0 14 31] (d: t_Decision) : int = [%#sdecision'1] match d with
    | Allow -> 0
    | Ask -> 1
    | Block -> 2
    end

function join_l [#"src/decision.rs" 30 0 30 51] (a: t_Decision) (b: t_Decision) : t_Decision =
  [%#sdecision'0] if ge_log_Int (rank a) (rank b) then a else b

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_Decision

constant b : t_Decision

function lemma_join_comm [#"src/decision.rs" 52 0 52 48] (a: t_Decision) (b: t_Decision) : ()

goal vc_lemma_join_comm: [@stop_split] [@expl:lemma_join_comm ensures] [%#sdecision] join_l a b = join_l b a
