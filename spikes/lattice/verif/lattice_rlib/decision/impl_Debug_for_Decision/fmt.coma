(* #"src/decision.rs" 5 22 5 27 *)

(* <decision::Decision as std::fmt::Debug> *)

let%span sinvariant = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/invariant.rs" 98 20 98 44
let%span sdecision = "src/decision.rs" 5 22 5 27
let%span smod = "../../../../../../../../../rustc/11177f2235f0c842b00f82c558ad9480c0c3a895/library/core/src/fmt/mod.rs" 2099 26 2099 30

use creusot.prelude.MutBorrow
use creusot.prelude.Any

type t_Decision = Allow | Ask | Block

type t_Formatter

predicate inv_Formatter (_1: t_Formatter)

type t_Result_unit_Error = Ok () | Err ()

predicate invariant_refmut_Formatter [@inline:trivial] (self: MutBorrow.t t_Formatter) =
  [%#sinvariant] inv_Formatter self.current /\ inv_Formatter self.final

meta "rewrite_def" predicate invariant_refmut_Formatter

predicate inv_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = invariant_refmut_Formatter _1

meta "rewrite_def" predicate inv_refmut_Formatter

let write_str (self: MutBorrow.t t_Formatter) (data: string) (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:write_str 'self' type invariant] [%#smod] inv_refmut_Formatter self}
  any [ return (result: t_Result_unit_Error) -> (! return {result}) ]

predicate resolve_refmut_Formatter [@inline:trivial] (_1: MutBorrow.t t_Formatter) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Formatter

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let fmt_Decision [#"src/decision.rs" 5 22 5 27] (self: t_Decision) (f: MutBorrow.t t_Formatter)
  (return (x: t_Result_unit_Error)) =
{[@stop_split] [@expl:fmt 'f' type invariant] [%#sdecision] inv_refmut_Formatter f}
  (! bb0
  [ bb0 = any [ br0 -> {self = Allow} (! bb6) | br1 -> {self = Ask} (! bb5) | br2 -> {self = Block} (! bb4) ]
  | bb4 = s0 [ s0 = [ &_8 <- [%#sdecision] "Block" ] s1 | s1 = [ &_4 <- _8 ] s2 | s2 = bb7 ]
  | bb5 = s0 [ s0 = [ &_7 <- [%#sdecision] "Ask" ] s1 | s1 = [ &_4 <- _7 ] s2 | s2 = bb7 ]
  | bb6 = s0 [ s0 = [ &_6 <- [%#sdecision] "Allow" ] s1 | s1 = [ &_4 <- _6 ] s2 | s2 = bb7 ]
  | bb7 = s0
    [ s0 = MutBorrow.borrow_final <t_Formatter> {f.current} {MutBorrow.get_id f}
        (fun (_bor: MutBorrow.t t_Formatter) ->
          [ &_3 <- _bor ] -{inv_Formatter _bor.final}-
          [ &f <- { f with current = _bor.final } ] s1)
      [ _ck -> (! {[@expl:type invariant] inv_Formatter f.current} any) ]
    | s1 = write_str [%#sdecision] {_3} {_4} (fun (_x: t_Result_unit_Error) -> [ &_ret <- _x ] s2)
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_Formatter f} any) ]
    | s3 = -{resolve_refmut_Formatter f}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: t_Result_unit_Error = Any.any_l ()
  | & self: t_Decision = self
  | & f: MutBorrow.t t_Formatter = f
  | & _3: MutBorrow.t t_Formatter = Any.any_l ()
  | & _4: string = Any.any_l ()
  | & _6: string = Any.any_l ()
  | & _7: string = Any.any_l ()
  | & _8: string = Any.any_l () ]) [ return (result: t_Result_unit_Error) -> (! return {result}) ]
