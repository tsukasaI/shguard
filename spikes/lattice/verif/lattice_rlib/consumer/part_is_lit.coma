use seq.Seq
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Witness__private

type t_Vec_Part_Global

type t_Word = { parts: t_Vec_Part_Global }

type t_Witness = { words: Seq.seq t_Word; t_Witness__private: t_Witness__private }

type t_Verdict = Allow t_Witness | Ask

let elim_Allow (_x: t_Verdict) (return (f0: t_Witness)) = any
  [ _k (f0: t_Witness) -> {Allow f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Allow] match _x with
      | Allow _ -> true
      | _ -> false
      end}
    any) ]

type t_Vec_u8_Global

type t_Part = Lit t_Vec_u8_Global | Opaque t_Vec_u8_Global

predicate is_lit [#"src/words.rs" 15 0 15 30] (p: t_Part) =
  [%#swords] match p with
    | Lit _ -> true
    | Opaque _ -> false
    end

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_Part_Global (self: t_Vec_Part_Global) : Seq.seq t_Part

axiom view_Vec_Part_Global_spec:
  forall self: t_Vec_Part_Global [view_Vec_Part_Global self]. [%#svec] Seq.length (view_Vec_Part_Global self)
    <= UInt64.t'int const_MAX

predicate word_lit [#"src/words.rs" 24 0 24 32] (w: t_Word) =
  [%#swords'1] forall j: int. 0 <= j /\ j < Seq.length (view_Vec_Part_Global w.parts)
    -> is_lit (Seq.get (view_Vec_Part_Global w.parts) j)

predicate words_lit [#"src/words.rs" 30 0 30 39] (ws: Seq.seq t_Word) =
  [%#swords'0] forall i: int. 0 <= i /\ i < Seq.length ws -> word_lit (Seq.get ws i)

predicate invariant_Witness [#"src/witness.rs" 23 4 23 30] (self: t_Witness) = [%#switness] words_lit self.words

predicate inv__private (x: t_Witness__private)

predicate inv_Witness (_1: t_Witness)

axiom inv_axiom [@rewrite]: forall _1: t_Witness [inv_Witness _1]. inv_Witness _1
    = (invariant_Witness _1 /\ inv__private _1.t_Witness__private)

predicate inv_Verdict (_1: t_Verdict)

axiom inv_axiom'0 [@rewrite]: forall _1: t_Verdict [inv_Verdict _1]. inv_Verdict _1
    = match _1 with
      | Allow f0 -> inv_Witness f0
      | Ask -> true
      end

predicate invariant_ref_Verdict [@inline:trivial] (self: t_Verdict) = [%#sinvariant] inv_Verdict self

meta "rewrite_def" predicate invariant_ref_Verdict

predicate inv_ref_Verdict [@inline:trivial] (_1: t_Verdict) = invariant_ref_Verdict _1

meta "rewrite_def" predicate inv_ref_Verdict

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let part_is_lit [#"src/consumer.rs" 41 0 41 59] (v: t_Verdict) (i: UInt64.t) (j: UInt64.t) (return (x: bool)) =
{[@stop_split] [@expl:part_is_lit requires] ([@stop_split] [@expl:part_is_lit 'v' type invariant] [%#sconsumer'2] inv_ref_Verdict v)
  /\ ([@stop_split] [@expl:part_is_lit requires] [%#sconsumer'3] match v with
    | Allow w -> UInt64.t'int i < Seq.length w.words
    /\ UInt64.t'int j < Seq.length (view_Vec_Part_Global (Seq.get w.words (UInt64.t'int i)).parts)
    | Ask -> true
    end)}
  (! bb0
  [ bb0 = any [ br0 (x0: t_Witness) -> {v = Allow x0} (! bb4) | br1 -> {v = Ask} (! bb3) ]
  | bb3 = s0 [ s0 = [ &_ret <- [%#sconsumer] false ] s1 | s1 = return {_ret} ]
  | bb4 = s0
    [ s0 = elim_Allow {v} (fun (r0: t_Witness) -> [ &w <- r0 ] s1)
    | s1 =
      {[@expl:assertion] [%#sconsumer'0] is_lit (Seq.get (view_Vec_Part_Global (Seq.get w.words (UInt64.t'int i)).parts) (UInt64.t'int j))}
      s2
    | s2 = [ &_ret <- [%#sconsumer'1] true ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & v: t_Verdict = v
  | & i: UInt64.t = i
  | & j: UInt64.t = j
  | & w: t_Witness = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:part_is_lit ensures] [%#sconsumer'4] match v with
      | Allow w -> result
      /\ is_lit (Seq.get (view_Vec_Part_Global (Seq.get w.words (UInt64.t'int i)).parts) (UInt64.t'int j))
      | Ask -> not result
      end}
    (! return {result}) ]
