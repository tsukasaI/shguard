(* #"src/arena.rs" 62 0 62 44 *)

let%span sarena = "src/arena.rs" 55 11 55 16
let%span sarena'0 = "src/arena.rs" 56 11 56 32
let%span sarena'1 = "src/arena.rs" 57 11 57 22
let%span sarena'2 = "src/arena.rs" 58 10 61 1
let%span sarena'3 = "src/arena.rs" 31 8 31 8
let%span sarena'4 = "src/arena.rs" 42 10 42 21
let%span sarena'5 = "src/arena.rs" 40 11 40 16
let%span sarena'6 = "src/arena.rs" 41 11 41 32
let%span sarena'7 = "src/arena.rs" 45 8 49 9
let%span sarena'8 = "src/arena.rs" 23 16 23 23

use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use int.Int

type t_Node2 = Leaf UInt8.t | Node UInt64.t UInt64.t

predicate wf [#"src/arena.rs" 29 0 29 32] (s: Seq.seq t_Node2) =
  [%#sarena'3] forall k: int. 0 <= k /\ k < Seq.length s
    -> match Seq.get s k with
      | Leaf _ -> true
      | Node first len -> k < UInt64.t'int first /\ UInt64.t'int first + UInt64.t'int len <= Seq.length s
      end

predicate leaf_ok [#"src/arena.rs" 22 0 22 29] (v: UInt8.t) = [%#sarena'8] UInt8.t'int v < 10

predicate ok_at [#"src/arena.rs" 43 0 43 43] (s: Seq.seq t_Node2) (k: int)

axiom ok_at_def: forall s: Seq.seq t_Node2, k: int [ok_at s k]. ([%#sarena'5] wf s)
    -> ([%#sarena'6] 0 <= k /\ k < Seq.length s)
    -> ok_at s k
    = ([%#sarena'7] match Seq.get s k with
      | Leaf v -> leaf_ok v
      | Node first len -> forall c: int. UInt64.t'int first <= c /\ c < UInt64.t'int first + UInt64.t'int len
        -> ok_at s c
      end)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_Node2

constant k : int

function lemma_child_ok [#"src/arena.rs" 62 0 62 44] (s: Seq.seq t_Node2) (k: int) : ()

goal vc_lemma_child_ok: ([%#sarena] wf s)
  -> ([%#sarena'0] 0 <= k /\ k < Seq.length s)
  -> ([%#sarena'1] ok_at s k)
  -> ([@stop_split] [@expl:lemma_child_ok ensures] [%#sarena'2] match Seq.get s k with
    | Leaf _ -> true
    | Node first len -> forall c: int. UInt64.t'int first <= c /\ c < UInt64.t'int first + UInt64.t'int len -> ok_at s c
    end)
