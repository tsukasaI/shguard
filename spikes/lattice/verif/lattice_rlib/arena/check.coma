predicate ok_at [#"src/arena.rs" 43 0 43 47] (s: Seq.seq t_ArenaNode) (k: int)

axiom ok_at_def: forall s: Seq.seq t_ArenaNode, k: int [ok_at s k]. ([%#sarena'26] wf s)
    -> ([%#sarena'27] 0 <= k /\ k < Seq.length s)
