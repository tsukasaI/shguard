let%span sarena = "src/arena.rs" 42 10 42 21
let%span sarena'0 = "src/arena.rs" 40 11 40 16
let%span sarena'1 = "src/arena.rs" 41 11 41 32
let%span sarena'2 = "src/arena.rs" 31 8 31 8
let%span sarena'3 = "src/arena.rs" 23 16 23 23
let%span swell_founded = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/logic/well_founded.rs" 43 8 43 33
let%span sord = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/logic/ord.rs" 22 8 22 20

use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use int.Int

type t_Node2 = Leaf UInt8.t | Node UInt64.t UInt64.t

predicate wf [#"src/arena.rs" 29 0 29 32] (s: Seq.seq t_Node2) =
  [%#sarena'2] forall k: int. 0 <= k /\ k < Seq.length s
    -> match Seq.get s k with
      | Leaf _ -> true
      | Node first len -> k < UInt64.t'int first /\ UInt64.t'int first + UInt64.t'int len <= Seq.length s
      end

predicate leaf_ok [#"src/arena.rs" 22 0 22 29] (v: UInt8.t) = [%#sarena'3] UInt8.t'int v < 10

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_Node2

constant k : int

predicate ok_at [#"src/arena.rs" 43 0 43 43] (s: Seq.seq t_Node2) (k: int)

goal vc_ok_at: ([%#sarena'0] wf s)
  -> ([%#sarena'1] 0 <= k /\ k < Seq.length s)
  -> match Seq.get s k with
    | Leaf v -> true
    | Node first len -> forall c: int. if UInt64.t'int first <= c then
        if c < UInt64.t'int first + UInt64.t'int len then
          ([@stop_split] [@expl:ok_at requires] ([@stop_split] [@expl:ok_at requires #0] [%#sarena'0] wf s)
            /\ ([@stop_split] [@expl:ok_at requires #1] [%#sarena'1] 0 <= c /\ c < Seq.length s))
          /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sarena] Seq.length s - k) ([%#sarena] Seq.length s
          - c))
        else
          true
      
      else
        true
    
    end
