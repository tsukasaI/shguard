use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

type t_ConsTree = Leaf UInt8.t | Node t_ConsTree t_ConsTree | Nil

let elim_Node (_x: t_ConsTree) (return (f0: t_ConsTree) (f1: t_ConsTree)) = any
  [ _k (f0: t_ConsTree) (f1: t_ConsTree) -> {Node f0 f1 = _x} (! return {f0} {f1})
  | _chk -> (! {[@expl:elim Node] match _x with
      | Node _ _ -> true
      | _ -> false
      end}
    any) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function size [#"src/tree.rs" 46 0 46 31] (t: t_ConsTree) : int = [%#stree'7] match t with
    | Leaf _ -> 1
    | Node h tl -> size h + size tl + 1
    | Nil -> 1
    end

axiom size_spec: forall t: t_ConsTree [size t]. [%#stree'6] ge_log_Int (size t) 1

predicate leaf_ok [#"src/tree.rs" 29 0 29 29] (v: UInt8.t) = [%#stree'9] UInt8.t'int v < 10

predicate ok [#"src/tree.rs" 35 0 35 30] (t: t_ConsTree) =
  [%#stree'8] match t with
    | Leaf v -> leaf_ok v
    | Node h tl -> ok h /\ ok tl
    | Nil -> true
    end

let check' (t: t_ConsTree) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:check ensures] [%#stree'5] result = ok t} (! return {result}) ]

let elim_Leaf (_x: t_ConsTree) (return (f0: UInt8.t)) = any
  [ _k (f0: UInt8.t) -> {Leaf f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Leaf] match _x with
      | Leaf _ -> true
      | _ -> false
      end}
    any) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

