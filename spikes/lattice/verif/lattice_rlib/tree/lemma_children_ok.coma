(* #"src/tree.rs" 114 0 114 37 *)

let%span sord = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span stree = "src/tree.rs" 111 11 111 11
let%span stree'0 = "src/tree.rs" 112 11 112 22
let%span stree'1 = "src/tree.rs" 113 10 113 15
let%span stree'2 = "src/tree.rs" 56 10 56 21
let%span stree'3 = "src/tree.rs" 66 11 66 31
let%span stree'4 = "src/tree.rs" 58 4 61 5
let%span stree'5 = "src/tree.rs" 36 4 40 5
let%span stree'6 = "src/tree.rs" 68 4 77 5
let%span stree'7 = "src/tree.rs" 102 4 106 5
let%span stree'8 = "src/tree.rs" 30 16 30 23

use creusot.int.UInt8
use int.Int

type t_ConsTree = Leaf UInt8.t | Node t_ConsTree t_ConsTree | Nil

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function len [#"src/tree.rs" 57 0 57 30] (t: t_ConsTree) : int = [%#stree'4] match t with
    | Node _ tl -> len tl + 1
    | Leaf _ | Nil -> 0
    end

axiom len_spec: forall t: t_ConsTree [len t]. [%#stree'2] ge_log_Int (len t) 0

predicate leaf_ok [#"src/tree.rs" 29 0 29 29] (v: UInt8.t) = [%#stree'8] UInt8.t'int v < 10

predicate ok [#"src/tree.rs" 35 0 35 30] (t: t_ConsTree) =
  [%#stree'5] match t with
    | Leaf v -> leaf_ok v
    | Node h tl -> ok h /\ ok tl
    | Nil -> true
    end

function child [#"src/tree.rs" 67 0 67 45] (t: t_ConsTree) (i: int) : t_ConsTree = [%#stree'6] match t with
    | Node h tl -> if i = 0 then h else child tl (i - 1)
    | Leaf _ | Nil -> Nil
    end

predicate is_spine [#"src/tree.rs" 101 0 101 36] (t: t_ConsTree) =
  [%#stree'7] match t with
    | Node _ tl -> is_spine tl
    | Nil -> true
    | Leaf _ -> false
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant t : t_ConsTree

function lemma_children_ok [#"src/tree.rs" 114 0 114 37] (t: t_ConsTree) : ()

goal vc_lemma_children_ok: ([%#stree] forall i: int. 0 <= i /\ i < len t -> ok (child t i))
  -> ([%#stree'0] is_spine t)
  -> match t with
    | Node _ tl -> (forall i: int. if 0 <= i then
          ([@stop_split] [@expl:len ensures] [%#stree'2] ge_log_Int (len tl) 0)
          -> (if i < len tl then
            ([@stop_split] [@expl:child requires] [%#stree'3] 0 <= i /\ i < len tl)
            /\ ([@stop_split] [@expl:child requires] [%#stree'3] 0 <= i + 1 /\ i + 1 < len t)
          else
            true
          )
        else
          true
      )
    /\ (forall i: int. 0 <= i /\ i < len tl -> child tl i = child t (i + 1))
    && ([@stop_split] [@expl:lemma_children_ok requires] ([@stop_split] [@expl:lemma_children_ok requires #0] [%#stree] forall i: int. 0
              <= i
            /\ i < len tl -> ok (child tl i))
      /\ ([@stop_split] [@expl:lemma_children_ok requires #1] [%#stree'0] is_spine tl))
    /\ (([@stop_split] [@expl:lemma_children_ok ensures] [%#stree'1] ok tl)
    -> ([@stop_split] [@expl:lemma_children_ok ensures] [%#stree'1] ok t))
    | Leaf _ | Nil -> [@stop_split] [@expl:lemma_children_ok ensures] [%#stree'1] ok t
    end
