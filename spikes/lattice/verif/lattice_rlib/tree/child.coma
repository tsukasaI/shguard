(* #"src/tree.rs" 67 0 67 45 *)

let%span sord = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/logic/ord.rs" 34 8 34 21
let%span stree = "src/tree.rs" 66 11 66 31
let%span stree'0 = "src/tree.rs" 56 10 56 21
let%span stree'1 = "src/tree.rs" 58 4 61 5

use creusot.int.UInt8
use int.Int

type t_ConsTree = Leaf UInt8.t | Node t_ConsTree t_ConsTree | Nil

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function len [#"src/tree.rs" 57 0 57 30] (t: t_ConsTree) : int = [%#stree'1] match t with
    | Node _ tl -> len tl + 1
    | Leaf _ | Nil -> 0
    end

axiom len_spec: forall t: t_ConsTree [len t]. [%#stree'0] ge_log_Int (len t) 0

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant t : t_ConsTree

constant i : int

function child [#"src/tree.rs" 67 0 67 45] (t: t_ConsTree) (i: int) : t_ConsTree

goal vc_child: ([%#stree] 0 <= i /\ i < len t)
  -> match t with
    | Node h tl -> if i = 0 then true else [@stop_split] [@expl:child requires] [%#stree] 0 <= i - 1 /\ i - 1 < len tl
    | Leaf _ | Nil -> true
    end
