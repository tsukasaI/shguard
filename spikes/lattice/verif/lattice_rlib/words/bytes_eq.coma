use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

let len_u8 (self: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self)
    = UInt64.t'int result}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let bytes_eq [#"src/words.rs" 61 0 61 43] (a: Slice64.slice UInt8.t) (b: Slice64.slice UInt8.t) (return (x: bool)) =
(! bb0
  [ bb0 = s0
    [ s0 = len_u8 [%#swords] {a} (fun (_x: UInt64.t) -> [ &_8 <- _x ] s1)
    | s1 = len_u8 [%#swords'0] {b} (fun (_x: UInt64.t) -> [ &_10 <- _x ] s2)
    | s2 = [ &_7 <- _8 <> _10 ] s3
    | s3 = any [ br0 -> {_7 = false} (! bb4) | br1 -> {_7} (! bb3) ] ]
  | bb3 = s0 [ s0 = [ &_ret <- [%#swords'1] false ] s1 | s1 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &i <- [%#swords'2] (0: UInt64.t) ] s1 | s1 = bb5 ]
  | bb5 = bb5invariant
    [ bb5 = {[@expl:loop variant] well_founded_relation_Int variant_old_bb5 ([%#swords'3] Seq.length (Slice64.view a)
      - UInt64.t'int i)}
      bb5invariant
    | bb5invariant = {[@expl:loop invariant #0] [%#swords'6] UInt64.t'int i <= Seq.length (Slice64.view a)}
      {[@expl:loop invariant #1] [%#swords'5] forall k: int. 0 <= k /\ k < UInt64.t'int i
        -> Seq.get (Slice64.view a) k = Seq.get (Slice64.view b) k}
      (! [ &variant_old_bb5 <- [%#swords'3] Seq.length (Slice64.view a) - UInt64.t'int i ] s0)
      [ s0 = len_u8 [%#swords'4] {a} (fun (_x: UInt64.t) -> [ &_29 <- _x ] s1)
      | s1 = [ &_27 <- UInt64.lt i _29 ] s2
      | s2 = any [ br0 -> {_27 = false} (! bb13) | br1 -> {_27} (! bb8) ] ]
      [ bb8 = s0
        [ s0 = [ &_34 <- i ] s1
        | s1 = [ &_35 <- Slice64.length a ] s2
        | s2 = [ &_36 <- UInt64.lt _34 _35 ] s3
        | s3 = {[@expl:index in bounds] [%#swords'7] _36} s4
        | s4 = Slice64.get [%#swords'7] <UInt8.t> {a} {_34} (fun (r: UInt8.t) -> [ &_33 <- r ] s5)
        | s5 = [ &_38 <- i ] s6
        | s6 = [ &_39 <- Slice64.length b ] s7
        | s7 = [ &_40 <- UInt64.lt _38 _39 ] s8
        | s8 = {[@expl:index in bounds] [%#swords'8] _40} s9
        | s9 = Slice64.get [%#swords'8] <UInt8.t> {b} {_38} (fun (r: UInt8.t) -> [ &_37 <- r ] s10)
        | s10 = [ &_32 <- _33 <> _37 ] s11
        | s11 = any [ br0 -> {_32 = false} (! bb12) | br1 -> {_32} (! bb11) ] ]
      | bb12 = s0
        [ s0 = UInt64.add [%#swords'10] {i} {[%#swords'9] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1)
        | s1 = bb5 ] ] ]
  | bb11 = s0 [ s0 = [ &_ret <- [%#swords'11] false ] s1 | s1 = return {_ret} ]
  | bb13 = s0
    [ s0 = {[@expl:assertion] [%#swords'12] Seq.(==) (Slice64.view a) (Slice64.view b)} s1
    | s1 = [ &_ret <- [%#swords'13] true ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & a: Slice64.slice UInt8.t = a
  | & b: Slice64.slice UInt8.t = b
  | & _7: bool = Any.any_l ()
  | & _8: UInt64.t = Any.any_l ()
  | & _10: UInt64.t = Any.any_l ()
  | & i: UInt64.t = Any.any_l ()
  | & _27: bool = Any.any_l ()
  | & _29: UInt64.t = Any.any_l ()
  | & _32: bool = Any.any_l ()
  | & _33: UInt8.t = Any.any_l ()
  | & _34: UInt64.t = Any.any_l ()
  | & _35: UInt64.t = Any.any_l ()
  | & _36: bool = Any.any_l ()
  | & _37: UInt8.t = Any.any_l ()
  | & _38: UInt64.t = Any.any_l ()
  | & _39: UInt64.t = Any.any_l ()
  | & _40: bool = Any.any_l ()
  | & variant_old_bb5: int = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:bytes_eq ensures] [%#swords'14] result
    = (Slice64.view a = Slice64.view b)}
    (! return {result}) ]
