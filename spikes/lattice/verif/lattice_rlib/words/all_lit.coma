use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type t_Vec_Part_Global

type t_Word = { parts: t_Vec_Part_Global }

let len_Word (self: Slice64.slice t_Word) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Vec_u8_Global

type t_Part = Lit t_Vec_u8_Global | Opaque t_Vec_u8_Global

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_Part_Global (self: t_Vec_Part_Global) : Seq.seq t_Part

axiom view_Vec_Part_Global_spec:
  forall self: t_Vec_Part_Global [view_Vec_Part_Global self]. [%#svec] Seq.length (view_Vec_Part_Global self)
    <= UInt64.t'int const_MAX

predicate is_lit [#"src/words.rs" 15 0 15 30] (p: t_Part) =
  [%#swords'20] match p with
    | Lit _ -> true
    | Opaque _ -> false
    end

predicate word_lit [#"src/words.rs" 24 0 24 32] (w: t_Word) =
  [%#swords'19] forall j: int. 0 <= j /\ j < Seq.length (view_Vec_Part_Global w.parts)
    -> is_lit (Seq.get (view_Vec_Part_Global w.parts) j)

let len_Part (self: t_Vec_Part_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec'0] UInt64.t'int result
    = Seq.length (view_Vec_Part_Global self)}
    (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Part) =
  [%#sslice'0] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Part) (out: t_Part) =
  [%#sslice'1] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_Part_Global (self: t_Vec_Part_Global) (index: UInt64.t) (return (x: t_Part)) =
{[@stop_split] [@expl:index requires] [%#svec'1] in_bounds_usize index (view_Vec_Part_Global self)}
  any
  [ return (result: t_Part) ->
  {[@stop_split] [@expl:index ensures] [%#svec'2] has_value_usize index (view_Vec_Part_Global self) result}
    (! return {result}) ]

predicate words_lit [#"src/words.rs" 30 0 30 39] (ws: Seq.seq t_Word) =
  [%#swords'21] forall i: int. 0 <= i /\ i < Seq.length ws -> word_lit (Seq.get ws i)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let all_lit [#"src/words.rs" 37 0 37 35] (ws: Slice64.slice t_Word) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &i <- [%#swords] (0: UInt64.t) ] s1 | s1 = bb1 ]
  | bb1 = bb1invariant
    [ bb1 = {[@expl:loop variant] well_founded_relation_Int variant_old_bb1 ([%#swords'0] Seq.length (Slice64.view ws)
      - UInt64.t'int i)}
      bb1invariant
    | bb1invariant = {[@expl:loop invariant #0] [%#swords'3] UInt64.t'int i <= Seq.length (Slice64.view ws)}
      {[@expl:loop invariant #1] [%#swords'2] forall k: int. 0 <= k /\ k < UInt64.t'int i
        -> word_lit (Seq.get (Slice64.view ws) k)}
      (! [ &variant_old_bb1 <- [%#swords'0] Seq.length (Slice64.view ws) - UInt64.t'int i ] s0)
      [ s0 = len_Word [%#swords'1] {ws} (fun (_x: UInt64.t) -> [ &_19 <- _x ] s1)
      | s1 = [ &_17 <- UInt64.lt i _19 ] s2
      | s2 = any [ br0 -> {_17 = false} (! bb16) | br1 -> {_17} (! bb4) ] ]
      [ bb4 = s0
        [ s0 = [ &_22 <- i ] s1
        | s1 = [ &_23 <- Slice64.length ws ] s2
        | s2 = [ &_24 <- UInt64.lt _22 _23 ] s3
        | s3 = {[@expl:index in bounds] [%#swords'4] _24} s4
        | s4 = Slice64.get [%#swords'5] <t_Word> {ws} {_22} (fun (r: t_Word) -> [ &parts'0 <- r.parts ] s5)
        | s5 = [ &j <- [%#swords'6] (0: UInt64.t) ] s6
        | s6 = bb6 ]
      | bb6 = bb6invariant
        [ bb6 =
          {[@expl:loop variant] well_founded_relation_Int variant_old_bb6 ([%#swords'7] Seq.length (view_Vec_Part_Global parts'0)
          - UInt64.t'int j)}
          bb6invariant
        | bb6invariant = {[@expl:loop invariant #0] [%#swords'10] UInt64.t'int j
          <= Seq.length (view_Vec_Part_Global parts'0)}
          {[@expl:loop invariant #1] [%#swords'9] forall k: int. 0 <= k /\ k < UInt64.t'int j
            -> is_lit (Seq.get (view_Vec_Part_Global parts'0) k)}
          (! [ &variant_old_bb6 <- [%#swords'7] Seq.length (view_Vec_Part_Global parts'0) - UInt64.t'int j ] s0)
          [ s0 = len_Part [%#swords'8] {parts'0} (fun (_x: UInt64.t) -> [ &_39 <- _x ] s1)
          | s1 = [ &_37 <- UInt64.lt j _39 ] s2
          | s2 = any [ br0 -> {_37 = false} (! bb15) | br1 -> {_37} (! bb9) ] ]
          [ bb9 = s0
            [ s0 = index_Vec_Part_Global [%#swords'11] {parts'0} {j} (fun (_x: t_Part) -> [ &_43 <- _x ] s1)
            | s1 = [ &_42 <- _43 ] s2
            | s2 = any
              [ br0 (x0: t_Vec_u8_Global) -> {_42 = Lit x0} (! bb14)
              | br1 (x0: t_Vec_u8_Global) -> {_42 = Opaque x0} (! bb13) ] ]
          | bb14 = s0
            [ s0 = UInt64.add [%#swords'13] {j} {[%#swords'12] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &j <- _x ] s1)
            | s1 = bb6 ] ] ]
      | bb15 = s0
        [ s0 = UInt64.add [%#swords'15] {i} {[%#swords'14] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1)
        | s1 = bb1 ] ] ]
  | bb13 = s0 [ s0 = [ &_ret <- [%#swords'16] false ] s1 | s1 = return {_ret} ]
  | bb16 = s0 [ s0 = [ &_ret <- [%#swords'17] true ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & ws: Slice64.slice t_Word = ws
  | & i: UInt64.t = Any.any_l ()
  | & _17: bool = Any.any_l ()
  | & _19: UInt64.t = Any.any_l ()
  | & parts'0: t_Vec_Part_Global = Any.any_l ()
  | & _22: UInt64.t = Any.any_l ()
  | & _23: UInt64.t = Any.any_l ()
  | & _24: bool = Any.any_l ()
  | & j: UInt64.t = Any.any_l ()
  | & _37: bool = Any.any_l ()
  | & _39: UInt64.t = Any.any_l ()
  | & _42: t_Part = Any.any_l ()
  | & _43: t_Part = Any.any_l ()
  | & variant_old_bb1: int = Any.any_l ()
  | & variant_old_bb6: int = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:all_lit ensures] [%#swords'18] result = words_lit (Slice64.view ws)}
    (! return {result}) ]
