(* #"src/witness.rs" 39 0 39 46 *)

let%span svec = "../../../../../../../../../nix/store/yyhknmxa1m1gsfgwc6xsipqcd1hf5ccp-creusot-wrapped/share/creusot-std/src/std/vec.rs" 18 14 18 41
let%span suint_macros = "../../../../../../../../../rustc/11177f2235f0c842b00f82c558ad9480c0c3a895/library/core/src/num/uint_macros.rs" 51 8 51 27
let%span swords = "src/words.rs" 35 10 35 34
let%span swords'0 = "src/words.rs" 31 16 31 16
let%span swords'1 = "src/words.rs" 25 16 25 16
let%span swords'2 = "src/words.rs" 16 4 19 5
let%span switness = "src/witness.rs" 40 7 40 18
let%span switness'0 = "src/witness.rs" 43 29 43 32
let%span switness'1 = "src/witness.rs" 39 31 39 46
let%span switness'2 = "src/witness.rs" 35 10 38 1
let%span switness'3 = "src/witness.rs" 24 20 24 42

use creusot.slice.Slice64
use seq.Seq
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Vec_Part_Global

type t_Word = { parts: t_Vec_Part_Global }

type t_Vec_u8_Global

type t_Part = Lit t_Vec_u8_Global | Opaque t_Vec_u8_Global

constant const_MAX: UInt64.t = [%#suint_macros] (18446744073709551615: UInt64.t)

function view_Vec_Part_Global (self: t_Vec_Part_Global) : Seq.seq t_Part

axiom view_Vec_Part_Global_spec:
  forall self: t_Vec_Part_Global [view_Vec_Part_Global self]. [%#svec] Seq.length (view_Vec_Part_Global self)
    <= UInt64.t'int const_MAX

predicate is_lit [#"src/words.rs" 15 0 15 30] (p: t_Part) =
  [%#swords'2] match p with
    | Lit _ -> true
    | Opaque _ -> false
    end

predicate word_lit [#"src/words.rs" 24 0 24 32] (w: t_Word) =
  [%#swords'1] forall j: int. 0 <= j /\ j < Seq.length (view_Vec_Part_Global w.parts)
    -> is_lit (Seq.get (view_Vec_Part_Global w.parts) j)

predicate words_lit [#"src/words.rs" 30 0 30 39] (ws: Seq.seq t_Word) =
  [%#swords'0] forall i: int. 0 <= i /\ i < Seq.length ws -> word_lit (Seq.get ws i)

let all_lit (ws: Slice64.slice t_Word) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:all_lit ensures] [%#swords] result = words_lit (Slice64.view ws)}
    (! return {result}) ]

type t_Witness = { _sealed: (); words: Seq.seq t_Word }

type t_Option_Witness = None | Some t_Witness

predicate invariant_Witness [#"src/witness.rs" 23 4 23 30] (self: t_Witness) = [%#switness'3] words_lit self.words

predicate inv_Witness (_1: t_Witness)

axiom inv_axiom [@rewrite]: forall _1: t_Witness [inv_Witness _1]. inv_Witness _1 = invariant_Witness _1

predicate inv_Option_Witness (_1: t_Option_Witness)

axiom inv_axiom'0 [@rewrite]: forall _1: t_Option_Witness [inv_Option_Witness _1]. inv_Option_Witness _1
    = match _1 with
      | None -> true
      | Some f0 -> inv_Witness f0
      end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let certify [#"src/witness.rs" 39 0 39 46] (ws: Slice64.slice t_Word) (return (x: t_Option_Witness)) = (! bb0
  [ bb0 = s0
    [ s0 = all_lit [%#switness] {ws} (fun (_x: bool) -> [ &_4 <- _x ] s1)
    | s1 = any [ br0 -> {_4 = false} (! bb4) | br1 -> {_4} (! bb2) ] ]
  | bb2 = s0
    [ s0 = [ &_8 <- [%#switness'0] Slice64.view ws ] s1
    | s1 = [ &_6 <- { _sealed = _7; words = _8 } ] s2
    | s2 = [ &_ret <- Some _6 ] s3
    | s3 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Option_Witness = Any.any_l ()
  | & ws: Slice64.slice t_Word = ws
  | & _4: bool = Any.any_l ()
  | & _6: t_Witness = Any.any_l ()
  | & _7: () = Any.any_l ()
  | & _8: Seq.seq t_Word = Any.any_l () ])
  [ return (result: t_Option_Witness) ->
  {[@stop_split] [@expl:certify ensures] ([@stop_split] [@expl:certify result type invariant] [%#switness'1] inv_Option_Witness result)
    /\ ([@stop_split] [@expl:certify ensures] [%#switness'2] match result with
      | Some w -> w.words = Slice64.view ws
      | None -> not words_lit (Slice64.view ws)
      end)}
    (! return {result}) ]
