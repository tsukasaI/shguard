#!/usr/bin/env bash
# Prints the R0 metrics of the evaluation-core redesign (docs/rfc-redesign.md,
# issue #836) on stdout, one `metrics: <key>: <value>` line each.
#
# There is one implementation: tests/common/metrics.rs (its `report` lists
# the keys, `KIND_NEEDLES` defines the Unknown kinds), run here through the
# `metrics` test target, which `cargo test` also runs and prints.
set -euo pipefail

cd "$(dirname "$0")/.."
exec bash scripts/hermetic-cargo-test.sh --test metrics -q
